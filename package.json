{
  "name": "mikael-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test": "vinext build && node --test tests/rendered-html.test.mjs tests/backend-contract.test.mjs && vitest run --config tests/vitest.config.mts && playwright test --config tests/playwright.config.mts",
    "test:unit": "vinext build && node --test tests/rendered-html.test.mjs tests/backend-contract.test.mjs && vitest run --config tests/vitest.config.mts",
    "test:browser": "vinext build && playwright test --config tests/playwright.config.mts",
    "test:browser:headed": "vinext build && playwright test --config tests/playwright.config.mts --headed",
    "test:legacy": "vinext build && node --test tests/rendered-html.test.mjs tests/backend-contract.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "drizzle-orm": "0.45.2",
    "gsap": "3.13.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.0",
    "@cloudflare/workers-types": "5.20260812.1",
    "@playwright/test": "1.62.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "4.1.10",
    "vinext": "1.0.0-beta.2",
    "vite": "8.2.1",
    "wrangler": "4.122.0"
  },
  "type": "module"
}
